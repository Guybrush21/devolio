---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Skills from '../../components/Skills.astro';
import Experience from '../../components/Experience.astro';
import Projects from '../../components/Projects.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';

import { languages, isValidLang, getAlternateLang, type Language } from '../../lib/i18n';
import * as itData from '../../lib/data/it';
import * as enData from '../../lib/data/en';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

if (!isValidLang(lang)) {
  return Astro.redirect('/it/');
}

const data = lang === 'it' ? itData : enData;
const alternateLang = getAlternateLang(lang as Language);
---

<BaseLayout 
  title="Nicholas Pellizer | Freelance Software Developer"
  lang={lang}
  alternateLang={alternateLang}
>
  <Header links={data.navLinks} currentLang={lang as Language} />

  <main>
    <Hero 
      name={data.heroData.name}
      role={data.heroData.role}
      taglines={data.heroData.taglines}
      ctaContact={data.heroData.ctaContact}
      ctaDownload={data.heroData.ctaDownload}
    />

    <About 
      paragraphs={data.aboutData.paragraphs} 
      podcasts={data.aboutData.podcasts}
      title={data.sectionTitles.about}
      podcastIntro={data.ui.podcastIntro}
    />

    <Skills skills={data.skills} title={data.sectionTitles.skills} />

    <Experience jobs={data.jobs} title={data.sectionTitles.experience} />

    <Projects 
      projects={data.projects} 
      socialLinks={data.socialLinks}
      title={data.sectionTitles.projects}
      visitSiteLabel={data.ui.visitSite}
    />

    <Contact 
      intro={data.contactData.intro}
      contactItems={data.contactData.items}
      downloadCv={data.contactData.downloadCv}
      title={data.sectionTitles.contact}
    />
  </main>

  <Footer name={data.footerData.name} tagline={data.footerData.tagline} />
</BaseLayout>
