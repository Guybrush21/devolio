---
import { languages, isValidLang, type Language } from "../../lib/i18n";
import * as itData from "../../lib/data/it";
import * as enData from "../../lib/data/en";
import { technologies } from "../../lib/data/common";
import CVLayout from "../../components/cv/CVLayout.astro";
import CVSectionHeader from "../../components/cv/CVSectionHeader.astro";
import CVContactInfo from "../../components/cv/CVContactInfo.astro";
import CVExperienceItem from "../../components/cv/CVExperienceItem.astro";
import CVLanguages from "../../components/cv/CVLanguages.astro";
import CVTechStack from "../../components/cv/CVTechStack.astro";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

if (!isValidLang(lang)) {
  return Astro.redirect("/it/cv");
}

const data = lang === "it" ? itData : enData;
const alternateLang = lang === "it" ? "en" : "it";

const contactItems = [
  { type: "phone" as const, text: data.personalInfo.phone },
  { type: "email" as const, text: data.personalInfo.email },
  { type: "location" as const, text: data.personalInfo.location },
  { type: "date" as const, text: data.personalInfo.dateOfBirth },
  { type: "flag" as const, text: data.personalInfo.nationality },
  {
    type: "github" as const,
    text: "github.com/Guybrush21",
    href: "https://github.com/Guybrush21",
  },
  {
    type: "website" as const,
    text: "nicholaspellizer.it",
    href: "https://nicholaspellizer.it",
  },
];
---

<CVLayout
  lang={lang}
  title={`${data.heroData.name} | ${data.cvPage.title}`}
  description={`${data.heroData.name} - ${data.heroData.role} - Curriculum Vitae`}
  backToSite={data.cvPage.backToSite}
  printButton={data.cvPage.printButton}
  alternateLang={alternateLang}
>
  <header class="flex justify-between gap-6 font-mono m-4">
    <div class="flex-1 min-w-0">
      <h1 class="text-2xl font-bold text-cv-text mb-1">
        {data.personalInfo.name}
      </h1>
      <p class="font-mono text-base text-cv-purple font-medium mb-3">
        {data.personalInfo.role}
      </p>

      <CVContactInfo items={contactItems} />
    </div>
    <picture id="me-picture" class="hidden">
      <source srcset="/me.webp" type="image/webp" />
      <img
        src="/me.jpg"
        alt={data.heroData.name}
        class="w-[150px] h-[150px] rounded-lg border-2 border-cv-green shadow-md shrink-0 object-cover"
        loading="eager"
      />
    </picture>
  </header>

  <section class="px-4 py-2">
    <CVSectionHeader title={data.cvPage.summary} />
    <p class="text-sm leading-snug text-cv-text">
      {data.personalInfo.bio}
    </p>
  </section>

  <section class="px-4 py-2">
    <CVSectionHeader title={data.sectionTitles.experience} />
    {
      data.jobs.map((job) => (
        <CVExperienceItem
          role={job.role}
          company={job.company}
          period={job.period}
          summary={job.summary}
          stack={job.stack}
          highlights={job.highlights}
          achievements={job.achievements}
          achievementsLabel={data.cvPage.achievements}
        />
      ))
    }
  </section>

  <section class="px-4 py-2">
    <CVSectionHeader title={data.cvPage.otherActivities} />
    {
      data.otherActivities.map((activity) => (
        <CVExperienceItem
          role={activity.role}
          company={activity.title}
          period={activity.period}
          description={activity.description}
          link={activity.link}
        />
      ))
    }
  </section>

  <section class="px-4 py-2">
    <CVSectionHeader title={data.cvPage.languages} />
    <CVLanguages languages={data.personalInfo.languages} />
  </section>

  <section class="px-4 py-2 break-inside-avoid">
    <CVSectionHeader title={data.techLabels.techStack} />
    <CVTechStack technologies={technologies} labels={data.techLabels} />
  </section>
</CVLayout>
