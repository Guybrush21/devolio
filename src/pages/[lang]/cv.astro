---
import { languages, isValidLang, type Language } from "../../lib/i18n";
import * as itData from "../../lib/data/it";
import * as enData from "../../lib/data/en";
import { parseMarkdown } from "../../lib/markdown";
import {
  Mail,
  Phone,
  Globe,
  MapPin,
  Calendar,
  Flag,
  GitBranch,
} from "@lucide/astro";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

if (!isValidLang(lang)) {
  return Astro.redirect("/it/cv");
}

const data = lang === "it" ? itData : enData;
const alternateLang = lang === "it" ? "en" : "it";

// Calculate age from DOB
function calculateAge(dobString: string): number {
  const [day, month, year] = dobString.split("/").map(Number);
  const dob = new Date(year, month - 1, day);
  const today = new Date();
  let age = today.getFullYear() - dob.getFullYear();
  const monthDiff = today.getMonth() - dob.getMonth();
  if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
    age--;
  }
  return age;
}

const age = calculateAge(data.personalInfo.dateOfBirth);

const baseUrl = "https://www.nicholaspellizer.it";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`${data.heroData.name} - ${data.heroData.role} - Curriculum Vitae`}
    />
    <title>{data.heroData.name} | {data.cvPage.title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="alternate" hreflang="it" href={`${baseUrl}/it/cv`} />
    <link rel="alternate" hreflang="en" href={`${baseUrl}/en/cv`} />
    <link rel="canonical" href={`${baseUrl}/${lang}/cv`} />

    <style is:global>
      @import "tailwindcss";

      @theme {
        --color-cv-bg: #fafafa;
        --color-cv-text: #383a42;
        --color-cv-muted: #a0a1a7;
        --color-cv-purple: #a626a4;
        --color-cv-green: #50a14f;
        --color-cv-green-dark: #2d6a2c;
        --color-cv-border: #e5e5e5;

        --font-mono: "Fira Code", "Consolas", "Monaco", monospace;
        --font-sans: "Inter", system-ui, sans-serif;
      }

      body {
        font-family: var(--font-sans);
        background: var(--color-cv-bg);
        color: var(--color-cv-text);
        font-size: 10pt;
        line-height: 1.4;
      }

      /* Print optimizations */
      @media print {
        @theme {
          --color-cv-text: #000000;
          --color-cv-muted: #4a4a4a;
          --color-cv-purple: #7c3aed;
          --color-cv-green: #16a34a;
          --color-cv-green-dark: #15803d;
          --color-cv-border: #d1d5db;
        }

        body {
          font-size: 9.5pt;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        @page {
          margin: 12mm;
          size: A4;
        }
      }
    </style>
  </head>
  <body>
    <div class="flex justify-center w-full gap-2 print:hidden">
      <a
        href={`/${lang}/`}
        class="px-4 py-2 rounded-md text-sm font-medium font-mono bg-[--color-cv-bg] text-[--color-cv-text] border-2 border-[--color-cv-border] hover:bg-[--color-cv-border] transition"
      >
        {data.cvPage.backToSite}
      </a>
      <a
        href={`/${alternateLang}/cv`}
        class="px-4 py-2 rounded-md text-sm font-medium font-mono bg-[--color-cv-bg] text-[--color-cv-text] border-2 border-[--color-cv-border] hover:bg-[--color-cv-border] transition"
      >
        {alternateLang.toUpperCase()}
      </a>
      <button
        onclick="window.print()"
        class="px-4 py-2 rounded-md text-sm font-medium font-mono bg-[--color-cv-bg] text-[--color-cv-text] border-2 border-[--color-cv-border] hover:bg-[--color-cv-border] transition"
      >
        {data.cvPage.printButton}
      </button>
    </div>

    <div class="max-w-[210mm] mx-auto p-8 bg-[--color-cv-bg]">
      <header
        class="flex justify-between gap-6 border-b-4 border-dotted border-[--color-cv-purple] font-mono pb-3 mb-4"
      >
        <div class="flex-1 min-w-0">
          <h1 class="text-2xl font-bold text-[--color-cv-text] mb-1">
            {data.heroData.name}
          </h1>
          <p
            class="font-mono text-base text-[--color-cv-purple] font-medium mb-3"
          >
            {data.heroData.role}
          </p>

          <div
            class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[--color-cv-text]"
          >
            {
              data.contactData.items.map((item) => {
                if (item.label === "Email" || item.label === "📧") {
                  return (
                    <>
                      <div class="flex items-center gap-1.5">
                        <Mail class="w-4 h-4 text-[--color-cv-green] shrink-0" />
                        {item.href ? (
                          <a
                            href={item.href}
                            class="hover:text-[--color-cv-green] transition"
                          >
                            {item.value}
                          </a>
                        ) : (
                          <span>{item.value}</span>
                        )}
                      </div>
                      <span class="text-[--color-cv-muted]">|</span>
                    </>
                  );
                }
                if (
                  item.label === "Phone" ||
                  item.label === "📱" ||
                  item.label === "Telefono"
                ) {
                  return (
                    <>
                      <div class="flex items-center gap-1.5">
                        <Phone class="w-4 h-4 text-[--color-cv-green] shrink-0" />
                        {item.href ? (
                          <a
                            href={item.href}
                            class="hover:text-[--color-cv-green] transition"
                          >
                            {item.value}
                          </a>
                        ) : (
                          <span>{item.value}</span>
                        )}
                      </div>
                      <span class="text-[--color-cv-muted]">|</span>
                    </>
                  );
                }
                return null;
              })
            }

            <div class="flex items-center gap-1.5">
              <MapPin class="w-4 h-4 text-[--color-cv-green] shrink-0" />
              <span>{data.personalInfo.location}</span>
            </div>
            <span class="text-[--color-cv-muted]">|</span>

            <div class="flex items-center gap-1.5">
              <Calendar class="w-4 h-4 text-[--color-cv-green] shrink-0" />
              <span
                >{data.personalInfo.dateOfBirth} ({age}
                {lang === "it" ? "anni" : "years"})</span
              >
            </div>
            <span class="text-[--color-cv-muted]">|</span>

            <div class="flex items-center gap-1.5">
              <Flag class="w-4 h-4 text-[--color-cv-green] shrink-0" />
              <span>{data.personalInfo.nationality}</span>
            </div>
            <span class="text-[--color-cv-muted]">|</span>

            <div class="flex items-center gap-1.5">
              <GitBranch class="w-4 h-4 text-[--color-cv-green] shrink-0" />
              <a
                href="https://github.com/Guybrush21"
                target="_blank"
                rel="noopener"
                class="hover:text-[--color-cv-green] transition"
              >
                github.com/Guybrush21
              </a>
            </div>
            <span class="text-[--color-cv-muted]">|</span>

            <div class="flex items-center gap-1.5">
              <Globe class="w-4 h-4 text-[--color-cv-green] shrink-0" />
              <a
                href="https://nicholaspellizer.it"
                target="_blank"
                rel="noopener"
                class="hover:text-[--color-cv-green] transition"
              >
                nicholaspellizer.it
              </a>
            </div>
          </div>
        </div>

        <picture>
          <source srcset="/me.webp" type="image/webp" />
          <img
            src="/me.jpg"
            alt={data.heroData.name}
            class="w-[150px] h-[150px] rounded-lg border-2 border-[--color-cv-green] shadow-md shrink-0 object-cover"
            loading="eager"
          />
        </picture>
      </header>

      <section class="mb-4">
        <h2
          class="font-mono text-sm font-semibold text-[--color-cv-purple] uppercase tracking-wide border-b border-[--color-cv-border] pb-2 mb-2"
        >
          // {data.cvPage.summary}
        </h2>
        <p class="text-sm leading-snug text-[--color-cv-text]">
          {data.personalInfo.bio}
        </p>
      </section>

      <section class="mb-4">
        <h2
          class="font-mono text-sm font-semibold text-[--color-cv-purple] uppercase tracking-wide border-b border-[--color-cv-border] pb-2 mb-2"
        >
          // {data.sectionTitles.experience}
        </h2>
        {
          data.jobs.map((job) => (
            <div class="mb-3">
              <div class="flex justify-between items-baseline mb-0.5">
                <div class="font-mono text-sm">
                  <span class=" font-semibold text-[--color-cv-purple]">
                    {job.role}
                  </span>
                  <span> @ {job.company}</span>
                </div>
                <span class="font-mono text-sm text-[--color-cv-muted] whitespace-nowrap">
                  {job.period}
                </span>
              </div>
              <ul class="list-disc pl-4 space-y-0.5">
                {job.highlights.map((highlight) => (
                  <li
                    class="text-xs leading-snug text-[--color-cv-text]"
                    set:html={parseMarkdown(highlight)}
                  />
                ))}
              </ul>
            </div>
          ))
        }
      </section>
    </div>
  </body>
</html>
