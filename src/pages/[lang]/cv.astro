---
import "../../styles/global.css";
import { languages, isValidLang, type Language } from "../../lib/i18n";
import * as itData from "../../lib/data/it";
import * as enData from "../../lib/data/en";
import { parseMarkdown } from "../../lib/markdown";
import {
  Mail,
  Phone,
  Globe,
  MapPin,
  Calendar,
  Flag,
  GitBranch,
  GitFork,
} from "@lucide/astro";

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

if (!isValidLang(lang)) {
  return Astro.redirect("/it/cv");
}

const data = lang === "it" ? itData : enData;
const alternateLang = lang === "it" ? "en" : "it";

const baseUrl = "https://www.nicholaspellizer.it";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`${data.heroData.name} - ${data.heroData.role} - Curriculum Vitae`}
    />
    <title>{data.heroData.name} | {data.cvPage.title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="alternate" hreflang="it" href={`${baseUrl}/it/cv`} />
    <link rel="alternate" hreflang="en" href={`${baseUrl}/en/cv`} />
    <link rel="canonical" href={`${baseUrl}/${lang}/cv`} />

    <style>
      @media print {
        body {
          font-size: 9.5pt;
          -webkit-print-color-adjust: exact;
          print-color-adjust: exact;
        }

        @page {
          margin: 12mm;
          size: A4;
        }
      }
    </style>
  </head>

  <body class="bg-cv-bg text-cv-text text-[10pt] leading-snug">
    <div class="flex justify-center w-full gap-2 print:hidden">
      <a
        href={`/${lang}/`}
        class="px-4 py-2 rounded-md text-sm font-medium font-mono bg-cv-bg text-cv-text border-2 border-cv-border hover:opacity-80 transition"
      >
        {data.cvPage.backToSite}
      </a>
      <a
        href={`/${alternateLang}/cv`}
        class="px-4 py-2 rounded-md text-sm font-medium font-mono bg-cv-bg text-cv-text border-2 border-cv-border hover:opacity-80 transition"
      >
        {alternateLang.toUpperCase()}
      </a>
      <button
        onclick="window.print()"
        class="px-4 py-2 rounded-md text-sm font-medium font-mono bg-cv-green text-white hover:opacity-90 transition"
      >
        {data.cvPage.printButton}
      </button>
    </div>

    <div class="max-w-[210mm] mx-auto p-8 bg-cv-bg">
      <header
        class="flex justify-between gap-6 border-b-4 border-b-6 border-dotted border-cv-purple font-mono pb-2 m-4"
      >
        <div class="flex-1 min-w-0">
          <h1 class="text-2xl font-bold text-cv-text mb-1">
            {data.personalInfo.name}
          </h1>
          <p class="font-mono text-base text-cv-purple font-medium mb-3">
            {data.personalInfo.role}
          </p>

          <div
            class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-cv-text"
          >
            <div class="flex items-center gap-1.5">
              <Phone class="w-4 h-4 text-cv-green shrink-0" />
              <span>{data.personalInfo.phone}</span>
            </div>
            <span class="text-cv-muted">|</span>

            <div class="flex items-center gap-1.5">
              <Mail class="w-4 h-4 text-cv-green shrink-0" />
              <span>{data.personalInfo.email}</span>
            </div>
            <span class="text-cv-muted">|</span>

            <div class="flex items-center gap-1.5">
              <MapPin class="w-4 h-4 text-cv-green shrink-0" />
              <span>{data.personalInfo.location}</span>
            </div>
            <span class="text-cv-muted">|</span>

            <div class="flex items-center gap-1.5">
              <Calendar class="w-4 h-4 text-cv-green shrink-0" />
              <span>{data.personalInfo.dateOfBirth} </span>
            </div>
            <span class="text-cv-muted">|</span>

            <div class="flex items-center gap-1.5">
              <Flag class="w-4 h-4 text-cv-green shrink-0" />
              <span>{data.personalInfo.nationality}</span>
            </div>
            <span class="text-cv-muted">|</span>

            <div class="flex items-center gap-1.5">
              <GitBranch class="w-4 h-4 text-cv-green shrink-0" />
              <a
                href="https://github.com/Guybrush21"
                target="_blank"
                rel="noopener"
                class="hover:text-cv-green transition"
              >
                github.com/Guybrush21
              </a>
            </div>
            <span class="text-cv-muted">|</span>

            <div class="flex items-center gap-1.5">
              <Globe class="w-4 h-4 text-cv-green shrink-0" />
              <a
                href="https://nicholaspellizer.it"
                target="_blank"
                rel="noopener"
                class="hover:text-cv-green transition"
              >
                nicholaspellizer.it
              </a>
            </div>
          </div>
        </div>

        <!-- <picture> -->
        <!--   <source srcset="/me.webp" type="image/webp" /> -->
        <!--   <img -->
        <!--     src="/me.jpg" -->
        <!--     alt={data.heroData.name} -->
        <!--     class="w-[150px] h-[150px] rounded-lg border-2 border-cv-green shadow-md shrink-0 object-cover" -->
        <!--     loading="eager" -->
        <!--   /> -->
        <!-- </picture> -->
      </header>

      <section class="p-4">
        <h2
          class="font-mono text-sm font-semibold text-cv-purple uppercase tracking-wide border-b border-cv-border pb-2 mb-2"
        >
          // {data.cvPage.summary}
        </h2>
        <p class="text-sm leading-snug text-cv-text">
          {data.personalInfo.bio}
        </p>
      </section>

      <section class="p-4">
        <h2
          class="font-mono text-sm font-semibold text-cv-purple uppercase tracking-wide border-b border-cv-border pb-2 mb-2"
        >
          // {data.sectionTitles.experience}
        </h2>
        {
          data.jobs.map((job) => (
            <div class="mb-3 ">
              <div class="flex justify-between items-baseline mb-0.5">
                <div class="font-mono text-sm">
                  <span class="font-semibold text-cv-purple">{job.role}</span>
                  <span class="text-cv-text"> @ {job.company}</span>
                </div>
                <span class="font-mono text-sm text-cv-muted whitespace-nowrap">
                  {job.period}
                </span>
              </div>
              <ul class="list-disc pl-4 space-y-0.5">
                {job.highlights.map((highlight) => (
                  <li
                    class="text-xs leading-snug text-cv-text"
                    set:html={parseMarkdown(highlight)}
                  />
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <section class="p-4">
        <h2
          class="font-mono text-sm font-semibold text-cv-purple uppercase border-b border-cv-border pb-2 mb-2"
        >
          // {data.cvPage.languages}
        </h2>
        <div class="flex font-mono text-sm">
          {
            data.personalInfo.languages.map((language) => (
              <div class="flex-1">
                <p class="font-semibold text-cv-purple mb-0.5">
                  {language.name}
                </p>
                <p class="text-cv-text">{language.level}</p>
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </body>
</html>
