---
import SectionTitle from './SectionTitle.astro';
import SkillCard from './SkillCard.astro';

interface SkillGroup {
  category: string;
  items: string[];
  note?: string;
}

interface Props {
  title: string;
  skills: SkillGroup[];
}

const { title, skills } = Astro.props;
---

<section id="skills" class="py-20 bg-bg-secondary">
  <div class="max-w-6xl mx-auto px-6">
    <SectionTitle title={title} />
    <div class="flex flex-wrap flex-col justify-center lg:flex-row gap-6">
      {skills.map((skillGroup) => (
        <div class="w-full lg:w-1/5" >
          <SkillCard category={skillGroup.category} items={skillGroup.items} note={skillGroup.note} />
        </div>
      ))}
    </div>
  </div>
</section>
