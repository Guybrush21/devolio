---
import SectionTitle from './SectionTitle.astro';
import SkillCard from './SkillCard.astro';
import CardGrid from './CardGrid.astro';
import CardGridItem from './CardGridItem.astro';

interface SkillGroup {
  category: string;
  items: string[];
  note?: string;
}

interface Props {
  title: string;
  skills: SkillGroup[];
}

const { title, skills } = Astro.props;
---

<section id="skills" class="py-20 bg-bg-secondary">
  <div class="max-w-6xl mx-auto px-6">
    <SectionTitle title={title} />
    <CardGrid>
      {skills.map((skillGroup) => (
        <CardGridItem>
          <SkillCard category={skillGroup.category} items={skillGroup.items} note={skillGroup.note} />
        </CardGridItem>
      ))}
    </CardGrid>
  </div>
</section>
