---
interface Props {
  period: string;
  role: string;
  company: string;
  description: string;
}

const { period, role, company, description } = Astro.props;
---

<div class="relative pb-10 last:pb-0">
  <div class="absolute -left-[25px] top-1 w-3 h-3 bg-green rounded-full"></div>
  <span class="font-mono text-sm text-cyan font-medium">{period}</span>
  <h3 class="text-xl font-semibold text-white mt-1">{role}</h3>
  <p class="text-purple font-mono mb-2">{company}</p>
  <p class="text-text-muted max-w-xl">{description}</p>
</div>
