---
interface Props {
  period: string;
  role: string;
  company: string;
  highlights: string[];
}

const { period, role, company, highlights } = Astro.props;
---

<div class="relative pb-10 last:pb-0 first:pt-[-2]">
  <div class="absolute -left-[41px] top-1 w-4 h-4 bg-green rounded-full"></div>
  <span class="font-mono text-sm text-cyan font-medium">{period}</span>
  <h3 class="text-xl font-mono font-semibold text-white mt-1">{role}</h3>
  <p class="text-purple font-mono mb-2">{company}</p>
  <ul class="text-text-muted max-w-2xl list-disc list-inside space-y-1">
    {highlights.map((highlight) => (
      <li>{highlight}</li>
    ))}
  </ul>
</div>
