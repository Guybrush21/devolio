---
import SectionTitle from './SectionTitle.astro';
import ProjectCard from './ProjectCard.astro';

interface Project {
  name: string;
  url: string;
  description: string;
}

interface SocialLink {
  label: string;
  url: string;
}

interface Props {
  title: string;
  projects: Project[];
  socialLinks: SocialLink[];
  visitSiteLabel: string;
}

const { title, projects, socialLinks, visitSiteLabel } = Astro.props;
---

<section id="projects" class="py-20 bg-bg-secondary">
  <div class="max-w-6xl mx-auto px-6 ">
    <SectionTitle title={title} />
    <div class="flex flex-wrap justify-center flex-col lg:flex-row gap-6">
      {projects.map((project) => (
      <div class="w-full lg:w-1/4">
        <ProjectCard 
          name={project.name} 
          url={project.url} 
          description={project.description}
          visitSiteLabel={visitSiteLabel}
        />
      </div>
      ))}
    </div>
  </div>
</section>
