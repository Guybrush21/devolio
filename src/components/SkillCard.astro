---
interface Props {
  category: string;
  items: string[];
  note?: string;
}

const { category, items, note } = Astro.props;
---

<div class="bg-bg p-6 rounded-lg border border-border">
  <h3 class="font-mono text-sm font-semibold text-purple mb-4">
    <span class="text-text-muted">-- </span>{category}
  </h3>
  <ul class="space-y-1">
    {items.map((skill) => (
      <li class="text-green font-mono text-sm">"{skill}"</li>
    ))}
  </ul>
  {note && (
    <p class="mt-4 text-text-muted font-mono text-xs italic">
      <span class="text-yellow">*</span> {note}
    </p>
  )}
</div>
