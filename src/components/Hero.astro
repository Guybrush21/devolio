---
import TerminalWindow from "./TerminalWindow.astro";
import Button from "./Button.astro";

interface Props {
  name: string;
  role: string;
  taglines: string[];
  stack: string;
  location: string;
  ctaContact: {
    href: string;
    label: string;
  };
  ctaDownload: {
    href: string;
    label: string;
  };
}

const { name, role, stack, location, taglines, ctaContact, ctaDownload } =
  Astro.props;

const terminalLines = [
  {
    type: "assignment" as const,
    keyword: "let",
    variable: "name",
    value: name,
  },
  {
    type: "assignment" as const,
    keyword: "let",
    variable: "role",
    value: role,
  },
  {
    type: "assignment" as const,
    keyword: "let",
    variable: "stack",
    value: stack,
  },
  {
    type: "assignment" as const,
    keyword: "let",
    variable: "location",
    value: location,
  },
  { type: "empty" as const },
  ...taglines.map((tagline) => ({
    type: "comment" as const,
    comment: tagline,
  })),
];
---

<section class="min-h-screen flex items-center pt-16">
  <div class="max-w-6xl mx-auto px-6 w-full">
    <div class="max-w-3xl">
      <TerminalWindow filename="~/.profile" lines={terminalLines} />
      <div class="flex flex-col sm:flex-row gap-4">
        <Button href={ctaContact.href}>
          :{ctaContact.label}
        </Button>
        <Button href={ctaDownload.href} variant="secondary" download>
          :{ctaDownload.label}
        </Button>
      </div>
    </div>
  </div>
</section>
