---
import TerminalWindow from './TerminalWindow.astro';

interface Props {
  name: string;
  role: string;
  taglines: string[];
  ctaContact: {
    href: string;
    label: string;
  };
  ctaDownload: {
    href: string;
    label: string;
  };
}

const { name, role, taglines, ctaContact, ctaDownload } = Astro.props;

const terminalLines = [
  { type: 'assignment' as const, keyword: 'local', variable: 'name', value: name },
  { type: 'assignment' as const, keyword: 'local', variable: 'role', value: role },
  { type: 'empty' as const },
  ...taglines.map(tagline => ({ type: 'comment' as const, comment: tagline })),
];
---

<section class="min-h-screen flex items-center pt-16">
  <div class="max-w-6xl mx-auto px-6 w-full">
    <div class="max-w-3xl">
      <TerminalWindow filename="~/.profile" lines={terminalLines} />
      <div class="flex flex-col sm:flex-row gap-4">
        <a 
          href={ctaContact.href} 
          class="inline-block px-7 py-3.5 font-mono font-semibold rounded bg-green text-bg-dark hover:bg-green/80 transition-colors text-center"
        >
          :{ctaContact.label}
        </a>
        <a 
          href={ctaDownload.href} 
          download 
          class="inline-block px-7 py-3.5 font-mono font-semibold rounded border-2 border-border text-text hover:border-accent hover:text-accent transition-colors text-center"
        >
          :{ctaDownload.label}
        </a>
      </div>
    </div>
  </div>
</section>
