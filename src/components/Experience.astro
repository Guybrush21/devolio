---
import SectionTitle from "./SectionTitle.astro";
import TimelineItem from "./TimelineItem.astro";

interface Job {
  period: string;
  role: string;
  company: string;
  highlights: string[];
}

interface Props {
  title: string;
  jobs: Job[];
  more: string;
}

const { title, jobs, more } = Astro.props;
---

<section id="experience" class="py-20">
  <div class="max-w-6xl mx-auto px-6">
    <SectionTitle title={title} />
    <div class="relative pl-8 border-l-2 border-border">
      {
        jobs.map((job) => (
          <TimelineItem
            period={job.period}
            role={job.role}
            company={job.company}
            highlights={job.highlights}
          />
        ))
      }
    </div>
    <button>
      <a
        href="cv"
        class="mt-8 inline-block bg-accent text-bg-dark font-mono text-sm font-semibold px-6 py-3 rounded hover:bg-accent-dark transition-colors"
      >
        {more}
      </a>
    </button>
  </div>
</section>
