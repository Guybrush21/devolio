---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  download?: boolean;
  class?: string;
}

const { href, variant = "primary", download = false, class: className = "" } = Astro.props;

const baseClasses = "inline-block px-7 py-3.5 font-mono font-semibold rounded transition-colors text-center";

const variantClasses = {
  primary: "bg-green text-bg-dark hover:bg-green/80",
  secondary: "border-2 border-border text-text hover:border-accent hover:text-accent",
};

const classes = `${baseClasses} ${variantClasses[variant]} ${className}`.trim();
---

<a href={href} class={classes} download={download ? "" : undefined}>
  <slot />
</a>
