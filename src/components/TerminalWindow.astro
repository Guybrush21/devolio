---
interface Props {
  filename: string;
  lines: {
    type: "comment" | "assignment" | "empty";
    keyword?: string;
    variable?: string;
    value?: string;
    comment?: string;
  }[];
}

const { filename, lines } = Astro.props;
---

<div
  class="bg-bg-secondary rounded-lg border border-border overflow-hidden mb-8 shadow-2xl"
>
  <div
    class="bg-bg-highlight px-4 py-3 flex items-center gap-2 border-b border-border"
  >
    <span class="ml-2 font-mono text-sm text-text-muted">{filename}</span>
  </div>

  <div class="p-6 font-mono">
    {
      lines.map((line, i) => (
        <div class="flex leading-loose">
          <div class="pr-6 border-r border-border mr-6 text-text-muted text-right select-none w-6 shrink-0">
            {i + 1}
          </div>
          <div class="min-h-[1.8em] flex-1">
            {line.type === "comment" && (
              <span class="text-text-muted italic"> // {line.comment}</span>
            )}
            {line.type === "assignment" && (
              <>
                <span class="text-purple">{line.keyword}</span>{" "}
                <span class="text-red">{line.variable}</span>
                {" = "}
                <span class="text-green">"{line.value}"</span>
              </>
            )}
            {line.type === "empty" && <>&nbsp;</>}
          </div>
        </div>
      ))
    }
  </div>
</div>
