---
interface Props {
  filename: string;
  lines: {
    type: 'comment' | 'assignment' | 'empty';
    keyword?: string;
    variable?: string;
    value?: string;
    comment?: string;
  }[];
}

const { filename, lines } = Astro.props;
---

<div class="bg-bg-secondary rounded-lg border border-border overflow-hidden mb-8 shadow-2xl">
  <div class="bg-bg-highlight px-4 py-3 flex items-center gap-2 border-b border-border">
    <!-- <span class="w-3 h-3 rounded-full bg-red"></span> -->
    <!-- <span class="w-3 h-3 rounded-full bg-yellow"></span> -->
    <!-- <span class="w-3 h-3 rounded-full bg-green"></span> -->
    <span class="ml-2 font-mono text-sm text-text-muted">{filename}</span>
  </div>
  <div class="flex p-6">
    <div class="pr-6 border-r border-border mr-6 font-mono text-text-muted text-right select-none leading-loose">
      {lines.map((_, i) => (
        <div>{i + 1}</div>
      ))}
    </div>
    <div class="font-mono leading-loose">
      {lines.map((line) => (
        <p class="min-h-[1.8em]">
          {line.type === 'comment' && (
            <span class="text-text-muted italic">-- {line.comment}</span>
          )}
          {line.type === 'assignment' && (
            <>
              <span class="text-purple">{line.keyword}</span>
              {' '}
              <span class="text-red">{line.variable}</span>
              {' = '}
              <span class="text-green">"{line.value}"</span>
            </>
          )}
          {line.type === 'empty' && <>&nbsp;</>}
        </p>
      ))}
    </div>
  </div>
</div>
