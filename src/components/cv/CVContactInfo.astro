---
import {
  Mail,
  Phone,
  Globe,
  MapPin,
  Calendar,
  Flag,
  GitBranch,
} from "@lucide/astro";

interface ContactItem {
  type: "phone" | "email" | "location" | "date" | "flag" | "github" | "website";
  text: string;
  href?: string;
}

interface Props {
  items: ContactItem[];
}

const { items } = Astro.props;

const iconMap = {
  phone: Phone,
  email: Mail,
  location: MapPin,
  date: Calendar,
  flag: Flag,
  github: GitBranch,
  website: Globe,
};
---

<div
  class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-cv-text justify-between"
>
  {
    items.map((item, index) => {
      const Icon = iconMap[item.type];
      return (
        <>
          <div class="flex items-center gap-1.5">
            <Icon class="w-4 h-4 text-cv-green shrink-0" />
            {item.href ? (
              <a
                href={item.href}
                target="_blank"
                rel="noopener"
                class="hover:text-cv-green transition"
              >
                {item.text}
              </a>
            ) : (
              <span>{item.text}</span>
            )}
          </div>
          {index < items.length - 1 && (
            <span class="text-cv-muted">|</span>
          )}
        </>
      );
    })
  }
</div>
