---
import { marked } from "marked";

interface Props {
  role: string;
  company: string;
  period: string;
  summary?: string;
  stack?: string[];
  highlights?: string[];
  highlightsLabel?: string;
  achievements?: string[];
  achievementsLabel?: string;
  link?: {
    url: string;
    label: string;
  };
}

const {
  role,
  company,
  period,
  summary,
  stack,
  highlights,
  highlightsLabel = "Activities",
  achievements,
  achievementsLabel = "Achievements",
  link,
} = Astro.props;
---

<div class="mb-4 break-inside-avoid">
  <div class="flex justify-between items-baseline mb-0.5">
    <div class="font-mono text-sm">
      <span class="font-semibold text-cv-purple">{role}</span>
      <span class="text-cv-text"> @ {company}</span>
    </div>
    <span class="font-mono text-sm text-cv-muted whitespace-nowrap">
      {period}
    </span>
  </div>
  <div class="pl-4">
    {
      summary && (
        <p
          class="text-sm leading-snug text-cv-text mb-1"
          set:html={marked.parseInline(summary)}
        />
      )
    }
    <div class="flex flex-col gap-2">
      {
        highlights && (
          <div>
            <p class="text-xs font-semibold font-mono text-cv-purple mb-0.5">
              {highlightsLabel}:
            </p>

            <ul class="list-none space-y-0.5">
              {highlights.map((highlight) => (
                <li
                  class="before:content-['*'] before:font-mono before:text-cv-green text-xs leading-snug text-cv-text"
                  set:html={marked.parseInline(highlight)}
                />
              ))}
            </ul>
          </div>
        )
      }
      {
        achievements && (
          <div class="mb-1 ">
            <p class="text-xs font-semibold font-mono text-cv-purple mb-0.5">
              {achievementsLabel}:
            </p>
            <ul class="list-none  space-y-0.5">
              {achievements.map((achievement) => (
                <li
                  class="before:content-['*'] before:font-mono before:text-cv-green text-xs leading-snug text-cv-text"
                  set:html={marked.parseInline(achievement)}
                />
              ))}
            </ul>
          </div>
        )
      }
      {
        stack && (
          <div>
            <!-- <p class="font-semibold text-cv-purple text-xs">Tech:</p> -->
            <ul class="text-xs font-mono text-cv-green mb-1 ">
              {stack.map((tech) => (
                <li class="inline-block px-0.5">
                  {tech} {"|"}
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        link && (
          <div>
            <p class="text-xs">
              <a
                href={link.url}
                class="text-cv-green hover:underline font-mono"
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label}
              </a>
            </p>
          </div>
        )
      }
    </div>
  </div>
</div>
