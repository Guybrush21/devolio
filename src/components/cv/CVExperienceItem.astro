---
import { marked } from "marked";

interface Props {
  role: string;
  company: string;
  period: string;
  summary?: string;
  stack?: string[];
  highlights?: string[];
  achievements?: string[];
  achievementsLabel?: string;
  description?: string;
  link?: {
    url: string;
    label: string;
  };
}

const {
  role,
  company,
  period,
  summary,
  stack,
  highlights,
  achievements,
  achievementsLabel = "Achievements",
  description,
  link,
} = Astro.props;
---

<div class="mb-4 break-inside-avoid">
  <div class="flex justify-between items-baseline mb-0.5">
    <div class="font-mono text-sm">
      <span class="font-semibold text-cv-purple">{role}</span>
      <span class="text-cv-text"> @ {company}</span>
    </div>
    <span class="font-mono text-sm text-cv-muted whitespace-nowrap">
      {period}
    </span>
  </div>

  {
    summary && (
      <p class="text-xs leading-snug text-cv-text mb-1 italic">{summary}</p>
    )
  }

  {
    stack && (
      <p class="text-xs font-mono text-cv-green mb-1">
        {stack.join(" • ")}
      </p>
    )
  }

  {
    highlights && (
      <ul class="list-disc pl-4 space-y-0.5 mb-1">
        {highlights.map((highlight) => (
          <li
            class="text-xs leading-snug text-cv-text"
            set:html={marked.parseInline(highlight)}
          />
        ))}
      </ul>
    )
  }

  {
    achievements && (
      <div class="pl-4 mb-1">
        <p class="text-xs font-semibold text-cv-purple mb-0.5">
          {achievementsLabel}:
        </p>
        <ul class="list-none space-y-0.5">
          {achievements.map((achievement) => (
            <li
              class="text-xs leading-snug text-cv-text before:content-['✓'] before:text-cv-green before:mr-1.5 before:font-bold"
              set:html={marked.parseInline(achievement)}
            />
          ))}
        </ul>
      </div>
    )
  }

  {
    description && (
      <p class="text-xs leading-snug text-cv-text mb-1">{description}</p>
    )
  }

  {
    link && (
      <p class="text-xs">
        <a
          href={link.url}
          class="text-cv-green hover:underline font-mono"
          target="_blank"
          rel="noopener noreferrer"
        >
          {link.label}
        </a>
      </p>
    )
  }
</div>
