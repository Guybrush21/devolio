---
interface Props {
  name: string;
  tagline?: string;
}

const { name, tagline = "Available for freelance work." } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="py-8 border-t border-border text-center">
  <p class="text-text-muted font-mono text-sm">
    &copy; {currentYear} {name}. {tagline}
  </p>
</footer>
